{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aws-architecture-lab:fulfillment:handed-off-event:v1",
  "title": "FulfillmentHandedOffEvent",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "correlationId", "causationId", "aggregateType", "aggregateId", "payload"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "eventType": { "type": "string", "const": "FulfillmentHandedOff" },
    "eventVersion": { "type": "string", "const": "1.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "aggregateType": { "type": "string", "const": "Fulfillment" },
    "aggregateId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "payload": {
      "type": "object",
      "required": ["checkoutId", "reservationId", "status"],
      "properties": {
        "checkoutId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reservationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "status": { "type": "string", "const": "HANDED_OFF" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
