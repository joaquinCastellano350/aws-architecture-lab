{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aws-architecture-lab:payment:authorize-command:v1",
  "title": "AuthorizePaymentCommand",
  "type": "object",
  "required": ["schemaVersion", "commandType", "operationId", "checkoutId", "paymentId", "amountMinor", "currency", "correlationId", "causationId"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "commandType": { "type": "string", "const": "AuthorizePayment" },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "checkoutId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "paymentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "amountMinor": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "currency": { "type": "string", "enum": ["USD"] },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "additionalProperties": true
}
