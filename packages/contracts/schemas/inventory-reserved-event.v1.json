{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aws-architecture-lab:inventory:reserved-event:v1",
  "title": "InventoryReservedEvent",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "correlationId", "causationId", "aggregateType", "aggregateId", "payload"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "eventType": { "type": "string", "const": "InventoryReserved" },
    "eventVersion": { "type": "string", "const": "1.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "aggregateType": { "type": "string", "const": "InventoryReservation" },
    "aggregateId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "payload": {
      "type": "object",
      "required": ["itemId", "quantity", "status", "expiresAt"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "status": { "type": "string", "const": "RESERVED" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
