{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aws-architecture-lab:payment:rejected-outcome:v1",
  "title": "PaymentRejectedOutcome",
  "type": "object",
  "required": ["schemaVersion", "operationId", "checkoutId", "paymentId", "status", "rejectionCode"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "checkoutId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "paymentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "type": "string", "const": "REJECTED" },
    "rejectionCode": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "additionalProperties": true
}
