{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aws-architecture-lab:reconciliation:create-command:v1",
  "title": "CreateReconciliationCommand",
  "type": "object",
  "required": ["schemaVersion", "commandType", "operationId", "reconciliationId", "checkoutId", "correlationId", "causationId", "failedInvariant", "requiredAction", "attempts"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "commandType": { "type": "string", "const": "CreateReconciliation" },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "reconciliationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "checkoutId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "workflowVersionArn": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "failedInvariant": { "type": "string", "minLength": 1, "maxLength": 256 },
    "requiredAction": { "type": "string", "enum": ["COMPENSATE_INVENTORY", "COMPENSATE_PAYMENT_AUTHORIZATION", "COMPENSATE_RESERVED_FULFILLMENT", "COMPENSATE_CAPTURED_PAYMENT", "RECOVER_FULFILLMENT_HANDOFF", "CONFIRM_ORDER"] },
    "attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
    "lastError": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "additionalProperties": true
}
