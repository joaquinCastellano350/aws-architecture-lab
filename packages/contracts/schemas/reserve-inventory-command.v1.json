{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aws-architecture-lab:inventory:reserve-command:v1",
  "title": "ReserveInventoryCommand",
  "type": "object",
  "required": ["schemaVersion", "commandType", "operationId", "checkoutId", "reservationId", "itemId", "quantity", "expiresAt", "correlationId", "causationId"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "commandType": { "type": "string", "const": "ReserveInventory" },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "checkoutId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "reservationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "additionalProperties": true
}
