{
  "name": "@aws-architecture-lab/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "deploy:foundation": "npm run build && node dist/bin/deploy-foundation.js",
    "deploy:workload": "npm run build && node dist/bin/deploy-workload.js",
    "destroy:workload": "npm run build && node dist/bin/destroy-workload.js",
    "expiry:workload": "npm run build && node dist/bin/expiry-workload.js",
    "failure:workload": "npm run build && node dist/bin/failure-workload.js",
    "preflight": "npm run build && node dist/bin/preflight.js",
    "smoke:workload": "npm run build && node dist/bin/smoke-workload.js",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "synth": "npm run build && cdk synth",
    "synth:foundation": "npm run build && node dist/bin/synth-foundation.js",
    "synth:workload": "npm run build && node dist/bin/synth-workload.js",
    "verify:foundation": "npm run build && node dist/bin/verify-foundation.js"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/credential-provider-node": "3.972.82",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.3",
    "aws-cdk-lib": "2.268.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "aws-cdk": "2.1140.0"
  }
}
